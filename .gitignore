# This is a .gitignore file for Unity projects
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]serSettings/

# MemoryCaptures can get huge, they don't belong in Git
/[Mm]emoryCaptures/

# Asset meta data should only be ignored for Unity packages.
# /Assets/*.meta

# Autogenerated Visual Studio / VS Code files
.vs/
.gradle/
ExportedObj/
.unityproj
*.sln
*.csproj
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# Crashlytics generated file
crashlytics-build.properties

# Packed Unity project targets
*.unitypackage

# OS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db